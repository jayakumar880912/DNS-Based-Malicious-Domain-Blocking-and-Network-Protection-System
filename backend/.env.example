# ==============================================================================
# AegisDNS - DNS-Based Malicious Domain Blocking and Network Protection System
# Environment Configuration Template
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=aegis_super_secret_cyber_key_change_in_production_2026!
PORT=5000
HOST=0.0.0.0

# Database Configuration (SQLite Local Mode)
USE_SQLITE=True
FALLBACK_TO_SQLITE=true

# JWT Authentication
JWT_SECRET_KEY=aegis_jwt_cyber_token_secret_key_984321_secure!
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# DNS Resolver Daemon Configuration
DNS_LISTEN_HOST=127.0.0.1
DNS_LISTEN_PORT=5354
UPSTREAM_DNS_SERVER=1.1.1.1
UPSTREAM_DNS_PORT=53
SINKHOLE_IP=0.0.0.0
BLOCK_RESPONSE_TYPE=SINKHOLE_IP # 'SINKHOLE_IP' or 'NXDOMAIN'

# External Threat Intelligence APIs (Optional API Keys)
# Google Safe Browsing API Key:
GOOGLE_SAFE_BROWSING_API_KEY=
# AbuseIPDB API Key:
ABUSEIPDB_API_KEY=
# AlienVault OTX API Key:
ALIENVAULT_OTX_API_KEY=

# Default Administrator Seed
ADMIN_FULL_NAME=SecOps Administrator
ADMIN_USERNAME=admin_secops
ADMIN_EMAIL=admin@aegisdns.security
ADMIN_PASSWORD=CyberShield#2026!

